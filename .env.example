# ==============================================================================
# CARDEALER MONOREPO - ENVIRONMENT VARIABLES TEMPLATE
# Copy file này thành `.env` ở thư mục gốc hoặc trong từng app tương ứng
# ==============================================================================

# Node Environment
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cardealer_dev?schema=public"

# Backend API Service
API_PORT=4000
API_HOST="http://localhost:4000"
API_SECRET_KEY="replace-this-with-a-secure-random-string-in-production"

# Frontend Storefront (Next.js)
NEXT_PUBLIC_SITE_URL="https://xehyundaivinh.com"
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Admin Back-Office (Next.js)
NEXT_PUBLIC_ADMIN_URL="http://localhost:3001"

# AI Engine (Optional for development)
# OPENAI_API_KEY=""
# GEMINI_API_KEY=""

# Cloudinary Media Storage (Server-side only)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_FOLDER="cloudinary"
