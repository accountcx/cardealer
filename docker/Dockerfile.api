# ==============================================================================
# CARDEALER BACKEND API - MULTI-STAGE PRODUCTION DOCKERFILE
# Tối ưu hóa dung lượng với Turborepo Prune và Node.js 24 Alpine
# ==============================================================================

FROM node:24-alpine AS base
RUN apk update && apk add --no-cache libc6-compat
RUN npm install -g pnpm@10.5.2
WORKDIR /app

# Stage 1: Prune monorepo - Chỉ giữ lại @cardealer/api và các workspace package phụ thuộc
FROM base AS pruner
COPY . .
RUN pnpm dlx turbo prune @cardealer/api --docker

# Stage 2: Cài đặt dependencies (tận dụng Docker caching layer)
FROM base AS installer
WORKDIR /app

COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

COPY --from=pruner /app/out/full/ .

# Stage 3: Runner môi trường Production siêu nhẹ
FROM node:24-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 apiservice

COPY --from=installer /app .

USER apiservice
EXPOSE 4000
ENV API_PORT=4000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:4000/api/health || exit 1

CMD ["pnpm", "--filter", "@cardealer/api", "start"]
