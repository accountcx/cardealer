{
  "name": "cardealer-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=24",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "pnpm --filter @cardealer/database db:generate",
    "db:migrate": "pnpm --filter @cardealer/database db:migrate",
    "db:push": "pnpm --filter @cardealer/database db:push",
    "db:update-avatars": "pnpm --filter @cardealer/database exec tsx src/scripts/update-car-avatars.ts",
    "verify:phase-1": "pnpm --filter @cardealer/database exec tsx src/scripts/verify-phase-1.ts",
    "verify:phase-2": "pnpm --filter @cardealer/database exec tsx ../../scripts/verify-phase-2-rbac.ts",
    "verify:phase-3": "pnpm --filter @cardealer/database exec tsx ../../scripts/verify-phase-3-pricing-lead.ts",
    "verify:phase-4-1": "pnpm --filter @cardealer/core test",
    "verify:phase-4-2": "pnpm --filter @cardealer/core test src/__tests__/verify-phase-4-2.test.ts",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.9.8",
    "turbo": "^2.11.0",
    "typescript": "^7.0.2"
  }
}